<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>2.6.7</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<groupId>br.com.kazuo.pocapi</groupId>
	<artifactId>exemplo</artifactId>
	<version>${revision}</version>
	<name>Exemplo</name>
	<description>Exemplo API</description>
	<packaging>pom</packaging>

	<properties>
		<java.version>11</java.version>
		<revision>0.0.1-SNAPSHOT</revision>
		<resilience4j.version>1.7.1</resilience4j.version>
	</properties>

	<modules>
		<module>app/shared</module>
		<module>app/core/domain</module>
		<module>app/application/controller</module>
		<module>app/application/config</module>
		<module>app/application/dataprovider</module>
		<module>app/application/infra</module>
	</modules>

	<dependencyManagement>
			<dependencies>
					<dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot2</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>
				<dependency>
						<groupId>io.github.resilience4j</groupId>
						<artifactId>resilience4j-all</artifactId>
						<version>${resilience4j.version}</version>
				</dependency>


			</dependencies>
	</dependencyManagement>

	<build>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>flatten-maven-plugin</artifactId>
				<version>1.2.7</version>
				<configuration>
					<updatePomFile>true</updatePomFile>
					<flattenMode>resolveCiFriendliesOnly</flattenMode>
				</configuration>
				<executions>
					<execution>
						<id>flatten</id>
						<phase>process-resources</phase>
						<goals>
							<goal>flatten</goal>
						</goals>
					</execution>
					<execution>
						<id>flatten.clean</id>
						<phase>clean</phase>
						<goals>
							<goal>clean</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>

